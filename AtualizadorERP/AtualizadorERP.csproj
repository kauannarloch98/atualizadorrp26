<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>AtualizadorERP</AssemblyName>
    <Title>Atualizador de Sistemas - RP Info</Title>
    <Product>Atualizador RP Info</Product>
    <Description>Atualizador e Gerenciador de Versões da Suite de Sistemas RP Info</Description>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="erp_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

</Project>
