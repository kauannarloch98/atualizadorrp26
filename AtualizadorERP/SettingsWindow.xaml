<Window x:Class="AtualizadorERP.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do Atualizador" 
        Icon="app.ico"
        Height="680" Width="680"
        MinHeight="600" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Estilo Caixa de Texto Moderna -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo PasswordBox Moderno -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário -->
        <Style x:Key="SettingBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabs Content -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Border x:Name="BannerFirstRun" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" 
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="👋 Bem-vindo! Configuração Inicial de Acesso" FontSize="13" FontWeight="Bold" Foreground="#A5B4FC"/>
                    <TextBlock Text="Informe suas credenciais de FTP. As pastas das aplicações podem ser preenchidas agora ou conforme você for atualizar cada uma." 
                               FontSize="11.5" Foreground="#C7D2FE" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtHeaderTitle" Text="Painel de Configurações" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Gerencie o acesso ao servidor FTP e as pastas de instalação das aplicações RP Info." 
                       FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Conteúdo em Abas (Tabs) -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="#111827" BorderBrush="#1E293B" BorderThickness="1,1,1,0" 
                                        CornerRadius="8,8,0,0" Margin="0,0,6,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#1E293B"/>
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ABA 1: CONEXÃO FTP -->
            <TabItem Header="🌐 Servidor FTP">
                <Border Background="#161F30" BorderBrush="#22304A" BorderThickness="1" CornerRadius="0,8,8,8" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Host e Porta -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Servidor FTP (Host) *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtHost"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Porta *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtPort"/>
                                </StackPanel>
                            </Grid>

                            <!-- Usuário e Senha -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Usuário FTP *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtUser"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Senha FTP *" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="TxtPass"/>
                            </StackPanel>

                            <!-- Teste de Conexão -->
                            <Border Background="#0F172A" CornerRadius="8" Padding="14" BorderBrush="#1E293B" BorderThickness="1" Margin="0,6,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTestStatus" Text="Status da conexão: Pronto para testar" FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <Button x:Name="BtnTestFtp" Grid.Column="1" Content="Testar Conexão FTP" Padding="16,8"
                                            Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnTestFtp_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>

                            <Separator Background="#22304A" Margin="0,8,0,14"/>

                            <!-- Comportamento -->
                            <TextBlock Text="OPÇÕES GERAIS DE COMPORTAMENTO" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkAutoKill" Content="Verificar e fechar processos em execução automaticamente ao atualizar"/>
                            <CheckBox x:Name="ChkOpenFolder" Content="Abrir pasta de instalação automaticamente ao concluir"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ABA 2: PASTAS DE INSTALAÇÃO DAS APLICAÇÕES -->
            <TabItem Header="📁 Pastas das Aplicações">
                <Border Background="#161F30" BorderBrush="#22304A" BorderThickness="1" CornerRadius="0,8,8,8" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Defina a pasta onde cada sistema está instalado em seu computador (não é obrigatório preencher todas agora):" 
                                   FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PanelAppDirectories" Margin="0,0,8,0">
                                <!-- Preenchido dinamicamente no code-behind com cards para cada app -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Botões de Ação Inferiores -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Content="Cancelar" Margin="0,0,10,0" Padding="16,8" Background="#334155" Foreground="#94A3B8"
                    BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Salvar Configurações" Padding="20,8" Background="#2563EB" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
